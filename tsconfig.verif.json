{
  "compilerOptions": {
    "jsx": "react-jsx", "strict": true, "noEmit": true, "module": "esnext", "moduleResolution": "bundler", "target": "es2022",
    "skipLibCheck": true, "lib": ["es2023", "dom", "dom.iterable"], "allowImportingTsExtensions": true, "types": [],
    "paths": {
      "react": ["./remotion/node_modules/@types/react"], "react/*": ["./remotion/node_modules/@types/react/*"],
      "react-dom/*": ["./remotion/node_modules/@types/react-dom/*"], "*": ["./remotion/node_modules/*"]
    }
  },
  "include": ["app/ui/*.ts", "app/ui/*.tsx", "remotion/src/*.ts", "remotion/src/*.tsx"]
}
